# For the self-hosted SwiftCargo/AssertQuest stack — see
# ../../assertquest/docker-compose.yml (postgres + api services).
# Copy to local.env (git-ignored) and adjust if your local ports/credentials differ from the
# stack's checked-in defaults.
BASE_URL=http://localhost:4000
ADMIN_USERNAME=admin@swiftcargo.test
ADMIN_PASSWORD=
DISPATCHER_USERNAME=dispatcher@swiftcargo.test
DISPATCHER_PASSWORD=
DRIVER_USERNAME=driver@swiftcargo.test
DRIVER_PASSWORD=
CUSTOMER_USERNAME=customer@swiftcargo.test
CUSTOMER_PASSWORD=
# postgres service in docker-compose.yml: user/password/db all "assertquest". Published on 5433,
# not the compose file's default 5432 — see docker-compose.override.yml if a native Postgres
# service on this machine is also bound to 5432 (check with `Get-NetTCPConnection -LocalPort 5432`
# on Windows before assuming 5432 is free).
PRIMARY_DB_URL=postgresql://assertquest:assertquest@localhost:5433/assertquest
